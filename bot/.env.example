# --- Discord ---
# Bot token: Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# Right-click the server icon -> Copy Server ID (Developer Mode on)
DISCORD_GUILD_ID=
# Comma-separated user IDs that must see every language channel (ops accounts)
OPS_USER_IDS=730098096574562365

# --- Translation ---
# Primary provider. Forms: anthropic:<model> | openai:<model> | gemini:<model> | openrouter:<model>
TRANSLATION_PROVIDER=anthropic:claude-sonnet-5
# Optional fallbacks tried in order when the primary fails, comma-separated
TRANSLATION_FALLBACKS=
ANTHROPIC_API_KEY=
# Only needed for the bake-off or if used as a provider/fallback
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Storage (Supabase project -> Settings -> API) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Runtime ---
PORT=8080
LOG_LEVEL=info
TRANSLATION_CONCURRENCY=4
TRANSLATION_TIMEOUT_SEC=60
BACKFILL_LIMIT=200

# UID verification -------------------------------------------------------------
# Affiliate API credentials. Each key must come from the affiliate/agent account
# and carry the affiliate (not trading) permission. Leave a set blank and that
# exchange falls back to the mock provider.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
BLOFIN_API_KEY=
BLOFIN_API_SECRET=
BLOFIN_API_PASSPHRASE=
# Endpoint overrides, in case an exchange moves its affiliate route.
# BYBIT_AFFILIATE_PATH=/v5/user/aff-customer-info
# BITGET_AFFILIATE_PATH=/api/v2/broker/customer-commissions
# BLOFIN_AFFILIATE_PATH=/api/v1/affiliate/invitees
# Attempts allowed per member per window, to stop UID guessing.
VERIFY_MAX_ATTEMPTS=5
VERIFY_WINDOW_MIN=15
# Mock provider for exchanges with no credentials: "off" hides them instead.
VERIFY_MOCK=on
VERIFY_MOCK_UIDS=
# Channel for affiliate-credential alerts. Unset means log only.
VERIFY_ALERT_CHANNEL_ID=
# Hours between credential health probes.
VERIFY_HEALTH_HOURS=12
# Exchanges to hide from the picker, comma separated (e.g. one we cannot reach).
VERIFY_DISABLED=
