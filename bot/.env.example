# --- Discord ---
# Bot token: Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# Right-click the server icon -> Copy Server ID (Developer Mode on)
DISCORD_GUILD_ID=
# Comma-separated user IDs that must see every language channel (ops accounts)
OPS_USER_IDS=730098096574562365

# --- Translation ---
# Primary provider. Forms: anthropic:<model> | openai:<model> | gemini:<model> | openrouter:<model>
TRANSLATION_PROVIDER=anthropic:claude-sonnet-5
# Optional fallbacks tried in order when the primary fails, comma-separated
TRANSLATION_FALLBACKS=
ANTHROPIC_API_KEY=
# Only needed for the bake-off or if used as a provider/fallback
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Storage (Supabase project -> Settings -> API) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Runtime ---
PORT=8080
LOG_LEVEL=info
TRANSLATION_CONCURRENCY=4
TRANSLATION_TIMEOUT_SEC=60
BACKFILL_LIMIT=200
